{
	"name": "salvocortesiano/mailhealth",
	"type": "phpbb-extension",
	"description": "Mail Health - bounce handling and e-mail deliverability for phpBB. Collects delivery status notifications from a dedicated mailbox, classifies hard and soft bounces, and protects the board's sending reputation.",
	"homepage": "https://netshadows.de/ombra",
	"version": "1.0.24",
	"time": "2026-09-20",
	"keywords": [
		"phpbb",
		"extension",
		"email",
		"bounce",
		"dsn",
		"deliverability",
		"imap"
	],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Salvo Cortesiano",
			"email": "info@netshadows.de",
			"homepage": "https://netshadows.de/ombra",
			"role": "Lead Developer"
		}
	],
	"require": {
		"php": "^7.2 || ^8.0",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"phpbb/epv": "dev-master"
	},
	"extra": {
		"display-name": "Mail Health",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		}
	}
}
